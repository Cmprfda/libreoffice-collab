{
  "$schema": "../gen/schemas/windows-schema.json",
  "identifier": "default",
  "description": "Permissions granted to the dashboard window. Deliberately narrow: the UI can drive its own window, open the project page in the system browser, and nothing else. All network access goes through Rust commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "notification:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }]
    }
  ]
}
